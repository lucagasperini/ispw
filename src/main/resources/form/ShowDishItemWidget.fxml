<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<HBox prefHeight="120.0" prefWidth="1330.0" stylesheets="@../css/main.css" xmlns="http://javafx.com/javafx/25.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pickyeaters.logic.gui.ShowDishItemWidget">
   <children>
      <VBox prefHeight="80.0" prefWidth="276.0">
         <children>
            <Text fx:id="textName" strokeType="OUTSIDE" strokeWidth="0.0" text="DishName" wrappingWidth="270.0">
               <font>
                  <Font name="Calibri" size="20.0" />
               </font>
            </Text>
            <Text fx:id="textType" fill="#5e5e5e" strokeType="OUTSIDE" strokeWidth="0.0" text="DishCategory">
               <font>
                  <Font name="Calibri" size="16.0" />
               </font>
            </Text>
         </children>
      </VBox>
      <ScrollPane hbarPolicy="NEVER" prefHeight="80.0" prefWidth="466.0">
         <content>
            <Text fx:id="textDescription" strokeType="OUTSIDE" strokeWidth="0.0" text="DishDescription">
               <font>
                  <Font name="Calibri" size="14.0" />
               </font>
            </Text>
         </content>
      </ScrollPane>
      <ListView fx:id="listviewIngredient" prefHeight="80.0" prefWidth="334.0" />
      <VBox alignment="CENTER" prefHeight="80.0" prefWidth="252.0">
         <children>
            <Button fx:id="buttonShowDish" mnemonicParsing="false" onAction="#clickButtonShowDish" prefHeight="32.0" prefWidth="246.0" styleClass="bt-stepAction3" text="SHOW DISH">
               <VBox.margin>
                  <Insets bottom="2.0" top="2.0" />
               </VBox.margin>
            </Button>
         </children>
      </VBox>
   </children>
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
</HBox>
